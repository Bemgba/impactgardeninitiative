APP_NAME="Impact Garden Initiative"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.DevOptions.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL — WhoGoHost production) ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=devoptions
DB_USERNAME=devoptions_user
DB_PASSWORD=your_secure_password_here

# ── Session ───────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.DevOptions.org
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Cache ─────────────────────────────────────────────────────────────────
CACHE_STORE=file

# ── Queue ─────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=sync

# ── Mail ──────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.whogohost.com
MAIL_PORT=465
MAIL_USERNAME=noreply@DevOptions.org
MAIL_PASSWORD=your_mail_password_here
MAIL_FROM_ADDRESS="noreply@DevOptions.org"
MAIL_FROM_NAME="DevOptions Ltd"

VITE_APP_NAME="${APP_NAME}"
